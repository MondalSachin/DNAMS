{
  "conventions": {
    "extractionKey": "extraction.<IDP action>.<field>. IDP action = DNAMSIDPAction__mdt DeveloperName (DealerApplication, AddressVerificationForm, UtilityBill, OrgChart, PhotographsOfFacility). Top-level fields only: no table rows, wildcards or aggregates.",
    "recordKey": "Package.<field>, or a relationship path from the package up to three levels: Package.<lookup>__r.<field> (e.g. Package.Buying_Dealer__r.AccountNumber) or Package.<lookup>__r.<relationship>.<field> (e.g. Package.Primary_Contact__r.Account.Name, Package.Buying_Dealer__r.Parent.Name).",
    "staticKey": "A literal value, or a list for IN / NOT IN. Date token {TODAY-<n>} resolves at run time.",
    "missingDocument": "Rules whose source document type was not uploaded to the element are Not Applicable (Address Verification accepts the form OR a utility bill)."
  },
