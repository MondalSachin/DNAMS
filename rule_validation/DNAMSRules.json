    {
      "ruleId": "DA-V03",
      "ruleName": "Dealership Address Matches Account",
      "description": "Verify that the dealership address on the Dealer Application is the address held on the Dealer Account.",
      "aiInstructions": "Decide whether the two addresses identify the same physical location. Treat standard abbreviations (Rd/Road, St/Street, Ste/Suite), letter case, punctuation and a ZIP versus ZIP+4 as equivalent. A different street number, street name, city or state is a FAIL. Answer CANNOT_DECIDE if either address is too incomplete to compare.",
      "ruleType": "Validation",
      "relativeElementType": "Dealer Application",
      "validationMethod": "AIMatch",
      "ruleAppliedTo": "Element",
      "relativePackageType": "",
      "sourceFieldType": "Extraction",
